@model Assignment1.Models.Attendee

@{
    ViewData["Title"] = "Delete Attendee";
}

<h1>Delete Attendee</h1>

<h3>Are you sure you want to remove this attendee?</h3>

<div class="mb-4">
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
</div>

<form asp-controller="Attendees"
      asp-action="DeleteConfirmed"
      asp-route-eventId="@Model.EventId"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-controller="Attendees"
       asp-action="Index"
       asp-route-eventId="@Model.EventId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
