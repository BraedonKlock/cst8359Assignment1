@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

<p>
    <a asp-controller="Event"
       asp-action="Create"
       class="btn btn-primary">
        Create New Event
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var eventItem in Model)
        {
            <tr>
                <td>@eventItem.Title</td>
                <td>@eventItem.Date.ToString("yyyy-MM-dd")</td>
                <td>@eventItem.Location</td>
                <td>
                    <a asp-controller="Event"
                       asp-action="Details"
                       asp-route-id="@eventItem.Id">
                        Details
                    </a> |

                    <a asp-controller="Event"
                       asp-action="Edit"
                       asp-route-id="@eventItem.Id">
                        Edit
                    </a> |

                    <a asp-controller="Event"
                       asp-action="Delete"
                       asp-route-id="@eventItem.Id">
                        Delete
                    </a> |

                    <a asp-controller="Attendees"
                       asp-action="Index"
                       asp-route-eventId="@eventItem.Id">
                        Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
