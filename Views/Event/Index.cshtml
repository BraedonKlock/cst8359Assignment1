@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

<p>Select an event to manage attendees.</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var eventItem in Model)
        {
            <tr>
                <td>@eventItem.Title</td>
                <td>@eventItem.Date.ToString("yyyy-MM-dd")</td>
                <td>@eventItem.Location</td>
                <td>
                    <a asp-controller="Event"
                       asp-action="ManageAttendees"
                       asp-route-id="@eventItem.Id"
                       class="btn btn-primary">
                        Manage Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
