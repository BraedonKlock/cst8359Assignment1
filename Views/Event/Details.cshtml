@model Assignment1.Models.Event

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>

@if (!string.IsNullOrEmpty(Model.BannerUrl))
{
    <img src="@Model.BannerUrl"
         alt="Banner for @Model.Title"
         class="img-fluid mb-4"
         style="max-width: 600px;" />
}

<p>
    <strong>Description:</strong>
    @Model.Description
</p>

<p>
    <strong>Date:</strong>
    @Model.Date.ToString("yyyy-MM-dd hh:mm tt")
</p>

<p>
    <strong>Location:</strong>
    @Model.Location
</p>

<h2>Attendees</h2>

@if (Model.Attendees.Count == 0)
{
    <p>No attendees registered yet.</p>
}
else
{
    <ul>
        @foreach (var attendee in Model.Attendees)
        {
            <li>
                @attendee.Name (@attendee.Email)
            </li>
        }
    </ul>
}

<a asp-controller="Event"
   asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-secondary">
    Edit Event
</a>

<a asp-controller="Attendees"
   asp-action="Index"
   asp-route-eventId="@Model.Id"
   class="btn btn-info">
    Manage Attendees
</a>

<a asp-controller="Event"
   asp-action="Index"
   class="btn btn-link">
    Back to List
</a>
