@model Assignment1.Models.Event

@{
    ViewData["Title"] = "Manage Attendees";
}

<h1>Manage Attendees - @Model.Title</h1>

@if (ViewData["Message"] != null)
{
    <div class="alert alert-info">
        @ViewData["Message"]
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="card-title">Sign Up for @Model.Title</h2>

        <form asp-controller="Event"
              asp-action="ManageAttendees"
              asp-route-id="@Model.Id"
              method="post">

            <div class="mb-3">
                <label for="Name" class="form-label">Name</label>

                <input
                    type="text"
                    id="Name"
                    name="Name"
                    class="form-control"
                    required />
            </div>

            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>

                <input
                    type="email"
                    id="Email"
                    name="Email"
                    class="form-control"
                    required />
            </div>

            <button type="submit" class="btn btn-success">
                Sign Up
            </button>

            <a asp-controller="Event"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Events
            </a>
        </form>
    </div>
</div>

<h2>Current Attendees (@Model.Attendees.Count)</h2>

@if (Model.Attendees.Count == 0)
{
    <p>No attendees yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var attendee in Model.Attendees)
        {
            <li class="list-group-item">
                <strong>@attendee.Name</strong>
                (@attendee.Email)
            </li>
        }
    </ul>
}
